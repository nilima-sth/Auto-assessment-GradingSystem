DATABASE_PATH=../grades.db
OLLAMA_MODEL=mistral
POPPLER_PATH=
TROCR_MODEL=microsoft/trocr-base-handwritten
EMBEDDING_MODEL=all-MiniLM-L6-v2
ANSWER_CHUNK_SIZE=220
ANSWER_CHUNK_OVERLAP=80
SIMILARITY_THRESHOLD=0.6
LLM_PROVIDER=gemini
GEMINI_API_KEY=
